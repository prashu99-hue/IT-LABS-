# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Persistent Media Storage: Cloudinary (Free Tier - 25GB)
# Server-side only credentials used in server.ts for signed, persistent uploads of images, videos and PDFs.
#
# HOW TO CONFIGURE IN YOUR LOCAL ENVIRONMENT:
# 1. Create a local '.env' file in the project root:
#    cp .env.example .env
# 2. Fill in your actual credentials from your Cloudinary Dashboard:
#    (Console -> Settings or Dashboard -> Product Environment Credentials)
# 3. CRITICAL SECURITY RULES:
#    - Never commit '.env' to git (.gitignore already protects '.env*').
#    - Never paste your API Secret or raw keys in public chat, tickets, or pull requests.
#    - Never prefix CLOUDINARY_API_SECRET with VITE_ (Vite embeds VITE_* variables into client JS).
#    - The server acts as a secure API proxy (/api/upload-media) so browser clients never see your secret.
CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="your_api_key_here"
CLOUDINARY_API_SECRET="your_api_secret_here"

